<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the store contract on SQL Server with the shipped table scripts deployed. It needs a SQL
    Server instance named by HONEYDRUNK_MEMORY_TEST_SQLSERVER, so it is not in HoneyDrunk.Memory.slnx.
  -->
  <PropertyGroup><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HoneyDrunk.Memory.Providers.Data\HoneyDrunk.Memory.Providers.Data.csproj" />
    <ProjectReference Include="..\..\src\HoneyDrunk.Memory.Abstractions\HoneyDrunk.Memory.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\HoneyDrunk.Memory.Providers.Data.Tests\ReadConsistencyContract.cs" Link="Shared\ReadConsistencyContract.cs" />
    <Compile Include="..\HoneyDrunk.Memory.Providers.Data.Tests\RunBeforeFirst.cs" Link="Shared\RunBeforeFirst.cs" />
    <None Include="..\..\src\HoneyDrunk.Memory.Providers.Data\Sql\*.sql" Link="Sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HoneyDrunk.Standards" Version="0.4.4" PrivateAssets="all" />
    <PackageReference Include="HoneyDrunk.Standards.Tests" Version="0.4.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
</Project>
